{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "glow-agent",
  // Serves public/ as static assets; only /api/* runs src/worker.js.
  "main": "src/worker.js",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "glow.apoorvdarshan.com", "custom_domain": true }
  ],
  // Rate-limit counters and the cached sample-face analysis.
  "kv_namespaces": [
    { "binding": "GLOW_KV", "id": "376bbbd43ea240dfa0f1a68e59b7d150" }
  ],
  // Secrets (wrangler secret put): YOUCAM_API_KEY, PAYPAL_CLIENT_ID,
  // PAYPAL_CLIENT_SECRET, AI_API_KEY.
  // The agent uses Gemini through its OpenAI-compatible endpoint.
  "vars": {
    "YOUCAM_BASE": "https://yce-api-01.makeupar.com",
    "PAYPAL_BASE": "https://api-m.sandbox.paypal.com",
    "AI_BASE_URL": "https://generativelanguage.googleapis.com/v1beta/openai",
    "AI_MODEL": "gemini-3.8-flash"
  },
  "observability": { "enabled": true }
}
